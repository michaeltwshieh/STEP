  "claims": [
    {
      "id": "c_separate_personality",
      "kind": "answer_assertion",
      "option": null,
      "text": "An incorporated company has a legal personality distinct from its beneficial owner, including where one person owns or controls it.",
      "disposition": "supported"
    },
    {
      "id": "c_asset_ownership",
      "kind": "answer_assertion",
      "option": null,
      "text": "Assets vested in the company belong to the company rather than directly to the beneficial owner.",
      "disposition": "supported"
    },
    {
      "id": "c_one_man_effect",
      "kind": "answer_assertion",
      "option": null,
      "text": "The one-man and asset-holding features do not by themselves justify alter-ego treatment.",
      "disposition": "supported"
    },
    {
      "id": "c_veil_exception",
      "kind": "answer_assertion",
      "option": null,
      "text": "Exceptional statutory or judicial grounds can justify looking behind or disregarding separate personality, but those grounds require more than ownership or control alone.",
      "disposition": "supported"
    },
    {
      "id": "c_control_duties",
      "kind": "answer_assertion",
      "option": null,
      "text": "If the beneficial owner manages, directs or acts for the company, formal authority and director duties constrain the use of that control.",
      "disposition": "condition"
    },
    {
      "id": "c_conclusion",
      "kind": "answer_assertion",
      "option": null,
      "text": "The proposition is legally overbroad, while its practical description may fit some wholly controlled asset-holding structures.",
      "disposition": "used - outcome"
    }
